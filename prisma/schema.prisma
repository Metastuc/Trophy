generator client {
    provider = "prisma-client"
    output   = "../server/generated/prisma"
    runtime  = "bun"
}

datasource db {
    provider = "mongodb"
    url      = env("DATABASE_URL")
}

model User {
    id            String  @id @default(auto()) @map("_id") @db.ObjectId
    privyId       String  @unique
    username      String  @unique
    email         String  @unique
    profileImage  String  @default("https://trophy-stream.s3.eu-north-1.amazonaws.com/default-pfp.svg")
    walletAddress String  @unique
    emailVerified Boolean @default(false)

    bio          String        @default("")
    creatorToken CreatorToken?

    // content
    streams       Stream[]       @relation("UserStreams")
    notifications Notification[]

    // socials
    xUrl  String?
    ytUrl String?

    // social graph
    followers Follow[] @relation("UserFollowers")
    following Follow[] @relation("UserFollowing")

    // tips
    tipsReceived Tip[] @relation("ReceivedTips")
    tipsSent     Tip[] @relation("SentTips")

    // tokens
    holdings       Holding[]       @relation("UserHoldings")
    ClaimsHistory  ClaimsHistory[] @relation("UserClaimsHistory")
    ClaimsSchedule ClaimsSchedule?

    // all time stats
    stats Stats?

    // timestamps
    lastReadAt DateTime? @default(now())
    createdAt  DateTime? @default(now())
    updatedAt  DateTime? @updatedAt

    @@index([privyId, username, email, walletAddress])
    @@map("users")
}

model Stream {
    id          String    @id @default(auto()) @map("_id") @db.ObjectId
    roomId      String    @unique
    title       String
    scheduledAt DateTime?
    startedAt   DateTime?
    endedAt     DateTime?
    viewers     Int       @default(0)
    thumbnail   String?
    status      Status

    streamer   User   @relation("UserStreams", fields: [streamerId], references: [id])
    streamerId String @db.ObjectId

    CreatorToken   CreatorToken? @relation("TokenStreams", fields: [creatorTokenId], references: [id])
    creatorTokenId String?       @db.ObjectId

    createdAt DateTime? @default(now())
    updatedAt DateTime? @updatedAt

    @@index([status, scheduledAt, title])
    @@map("streams")
}

enum Status {
    LIVE
    SCHEDULED
    ENDED
}

model CreatorToken {
    id           String @id @default(auto()) @map("_id") @db.ObjectId
    address      String @unique
    symbol       String @unique
    name         String @unique
    smartAccount String @unique
    image        String

    // Creator (one-to-one with User)
    creator   User?  @relation(fields: [creatorId], references: [id])
    creatorId String @unique @db.ObjectId

    // relations
    holdings Holding[] @relation("TokenHoldings")
    streams  Stream[]  @relation("TokenStreams")

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([symbol, name])
    @@map("tokens")
}

model Holding {
    id String @id @default(auto()) @map("_id") @db.ObjectId

    // holder (viewer/investor)
    user   User   @relation("UserHoldings", fields: [userId], references: [id])
    userId String @db.ObjectId

    // creator whose token is held
    creatorToken   CreatorToken @relation("TokenHoldings", fields: [creatorTokenId], references: [id])
    creatorTokenId String       @db.ObjectId

    amount Float

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([userId, creatorTokenId])
    @@map("holdings")
}

model Notification {
    id     String @id @default(auto()) @map("_id") @db.ObjectId
    user   User   @relation(fields: [userId], references: [id]) // recipient
    userId String @db.ObjectId

    type      NotificationType
    message   String
    createdAt DateTime         @default(now())

    // relations
    follow Follow? @relation("FollowNotification")
    tip    Tip?    @relation("TipNotification")

    @@index([userId, createdAt])
    @@map("notifications")
}

enum NotificationType {
    TIP
    FOLLOW
    PURCHASE
    SYSTEM
}

model Tip {
    id String @id @default(auto()) @map("_id") @db.ObjectId

    // receiver (creator)
    user   User   @relation("ReceivedTips", fields: [userId], references: [id])
    userId String @db.ObjectId

    // sender (tipper)
    tipper       User?   @relation("SentTips", fields: [tipperId], references: [id])
    tipperId     String? @db.ObjectId
    tipperWallet String?

    // onchain data
    txHash       String  @unique
    chainId      Int
    token        String?
    tokenAddress String?
    amount       Float
    amountRaw    String?
    amountUsd    Float?

    createdAt DateTime @default(now())

    // 1:1 notification
    notification   Notification? @relation("TipNotification", fields: [notificationId], references: [id])
    notificationId String?       @unique @db.ObjectId

    @@index([userId, tipperId, createdAt])
    @@map("tips")
}

model Follow {
    id         String @id @default(auto()) @map("_id") @db.ObjectId
    follower   User   @relation("UserFollowing", fields: [followerId], references: [id])
    followerId String @db.ObjectId

    following   User   @relation("UserFollowers", fields: [followingId], references: [id])
    followingId String @db.ObjectId

    createdAt DateTime @default(now())

    // 1:1 notification
    notification   Notification? @relation("FollowNotification", fields: [notificationId], references: [id])
    notificationId String?       @unique @db.ObjectId

    @@unique([followerId, followingId])
    @@map("follows")
}

model Stats {
    id String @id @default(auto()) @map("_id") @db.ObjectId

    // creator
    user   User   @relation(fields: [userId], references: [id])
    userId String @unique @db.ObjectId

    // metrics
    followerCount  Int       @default(0)
    followingCount Int       @default(0)
    totalStreams   Int       @default(0)
    epicStreams    Int       @default(0)
    totalFees      Float     @default(0)
    tipCount       Int       @default(0)
    holdingCount   Int       @default(0)
    tokenPrice     Float     @default(0)
    claimDate      DateTime?

    createdAt DateTime? @default(now())
    updatedAt DateTime? @updatedAt

    @@map("stats")
}

model ClaimsHistory {
    id String @id @default(auto()) @map("_id") @db.ObjectId

    // creator
    user   User   @relation("UserClaimsHistory", fields: [userId], references: [id])
    userId String @unique @db.ObjectId

    // claim details
    amount       Float
    token        String?
    tokenAddress String?
    txHash       String?  @unique
    claimedAt    DateTime @default(now())

    createdAt DateTime? @default(now())
    updatedAt DateTime? @updatedAt

    @@index([userId, claimedAt])
    @@map("claims_history")
}

model ClaimsSchedule {
    id String @id @default(auto()) @map("_id") @db.ObjectId

    user   User   @relation(fields: [userId], references: [id])
    userId String @unique @db.ObjectId

    lockedToken  Int
    totalClaimed Int      @default(0)
    tokenLeft    Int
    lastClaimed  DateTime @default(now())
    claimDate    DateTime

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("claims_schedule")
}
