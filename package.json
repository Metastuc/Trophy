        "pino-pretty": "^13.1.1",
        "prettier-plugin-organize-imports": "^4.2.0",
        "prettier-plugin-tailwindcss": "^0.6.14",
        "prisma": "^6.16.2",
        "react": "^19.1.1",
        "react-day-picker": "^9.10.0",
        "react-dom": "^19.1.1",
        "react-helmet": "^6.1.0",
        "rotating-file-stream": "^3.2.7",
        "sharp": "^0.34.4",
        "socket.io": "^4.8.1",
        "socket.io-client": "^4.8.1",
        "sonner": "^2.0.7",
