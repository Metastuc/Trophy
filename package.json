        "@types/express-serve-static-core": "^5.0.7",
        "@types/multer": "^2.0.0",
        "@types/node": "^24.5.2",
        "@types/nodemailer": "^7.0.1",
        "@types/nodemailer-express-handlebars": "^4.0.5",
        "@types/react": "^19.1.13",
        "@types/react-dom": "^19.1.9",
        "@vitejs/plugin-react-swc": "^4.1.0",
        "concurrently": "^9.2.1",
        "eslint": "^9.35.0",
        "eslint-plugin-react-hooks": "^5.2.0",
