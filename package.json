{
    "name": "trophy",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "build": "tsc -b && vite build",
        "db-pull": "bunx --bun dotenv -e .env.local -- bunx --bun prisma db pull",
        "dev": "bunx --bun vite",
        "lint": "bunx --bun eslint --fix . && bunx --bun prettier --write .",
        "preview": "vite preview",
        "prod": "prisma db push && pnpm exec tsx server/index.ts",
        "server": "bun --watch server/index.ts",
        "start": "concurrently \"npm run server\" \"npm run dev\""
    },
    "dependencies": {
        "@prisma/client": "^6.15.0",
        "@privy-io/server-auth": "^1.32.2",
        "cors": "^2.8.5",
        "date-fns": "^4.1.0",
        "dotenv": "^17.2.2",
        "dotenv-cli": "^10.0.0",
        "express": "^5.1.0",
        "http-proxy-middleware": "^3.0.5",
        "http-status": "^2.1.0",
        "pino": "^9.9.0",
        "pino-pretty": "^13.1.1",
        "prettier-plugin-organize-imports": "^4.2.0",
        "prettier-plugin-tailwindcss": "^0.6.14",
        "prisma": "^6.15.0",
        "react": "^19.1.1",
        "react-dom": "^19.1.1",
        "rotating-file-stream": "^3.2.7",
        "zod": "^4.1.5"
    },
    "devDependencies": {
        "@eslint/js": "^9.34.0",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.3",
        "@types/express-serve-static-core": "^5.0.7",
        "@types/node": "^24.3.0",
        "@types/react": "^19.1.12",
        "@types/react-dom": "^19.1.9",
        "@vitejs/plugin-react-swc": "^4.0.1",
        "concurrently": "^9.2.1",
        "eslint": "^9.34.0",
        "eslint-plugin-react-hooks": "^5.2.0",
        "eslint-plugin-react-refresh": "^0.4.20",
        "eslint-plugin-simple-import-sort": "^12.1.1",
        "globals": "^16.3.0",
        "tsx": "^4.20.5",
        "typescript": "~5.9.2",
        "typescript-eslint": "^8.42.0",
        "vite": "^7.1.4"
    },
    "imports": {
        "#*": "./server/*"
    }
}
