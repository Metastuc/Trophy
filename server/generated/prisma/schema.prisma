generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DB_URI")
}

model Stream {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  roomId       String   @unique
  createdAt    DateTime @default(now()) @map("created_at")
  title        String
  date         String?
  creatorToken String?
  viewers      Int      @default(0)
  pfp          String
  thumbnail    String?
  status       Status
  streamer     String

  @@index([date])
  @@index([status])
  @@index([streamer])
  @@index([title])
  @@map("streams")
}

enum Status {
  Live
  Scheduled
  Ended
}

model Notification {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  username      String   @unique
  read          Boolean  @default(false)
  followContent String   @default("")
  followNots    String[]
  recentFollows Int      @default(0)
  followedAt    DateTime @default(now())

  tip TipEntry[]

  buy String[]

  @@index([followedAt], map: "followedAt_ttl")
  @@map("notifications")
}

model TipTxs {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  username String @unique @default("trophy")
  USDC     Float  @default(0)
  ETH      Float  @default(0)
  FLAY     Float  @default(0)
  BNKR     Float  @default(0)
  ZORA     Float  @default(0)
  DEGEN    Float  @default(0)
  tx       Int    @default(1)
}

type TipEntry {
  token  String?
  amount String?
  tipper String?
}

model cVolume {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  volume   Int
  username String @unique @default("trophy")
}

model User {
  id            String       @id @default(auto()) @map("_id") @db.ObjectId
  privyId       String       @unique
  username      String       @unique
  email         String       @unique
  userPfp       String       @default("https://trophy-stream.s3.eu-north-1.amazonaws.com/default-pfp.svg")
  walletAddress String       @unique
  sa_address    String?
  tokenPrice    Float        @default(0)
  totalStreams  Int          @default(0)
  bio           String       @default("")
  epicStreams   Int          @default(0)
  totalFees     Float        @default(0)
  claimDate     DateTime?
  emailVerified Boolean      @default(false)
  role          StreamerRole @default(viewer)
  tokenImage    String?
  xUrl          String?
  ytUrl         String?
  followers     String[]
  following     String[]
  creatorToken  String?
  holdings      String[]

  @@map("users")
}

enum StreamerRole {
  guest
  host
  viewer
}
